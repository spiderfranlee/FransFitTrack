{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "challenge": {
          "type": "object",
          "description": "Optional challenge assigned to this client (e.g. October 2KM & Monday Yoga Challenge).",
          "properties": {
            "enabled": { "type": "boolean" },
            "title": { "type": "string" },
            "startDate": { "type": "string" },
            "endDate": { "type": "string" },
            "dailyKmTarget": { "type": "number" },
            "mondayYoga": { "type": "boolean" },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "type": { "type": "string" },
                  "target": { "type": "number" },
                  "unit": { "type": "string" },
                  "mondayOnly": { "type": "boolean" },
                  "reminder": { "type": "string" },
                  "hasCamera": { "type": "boolean" },
                  "optional": { "type": "boolean" },
                  "required": { "type": "boolean" }
                },
                "required": ["id", "title"]
              }
            }
          }
        }
      },
      "required": ["email"]
    },
    "ChallengeDailyLog": {
      "title": "ChallengeDailyLog",
      "description": "A client's daily completion log for their active challenge.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Date of the log in YYYY-MM-DD format." },
        "dayNumber": { "type": "integer", "description": "Sequential day number in the challenge (e.g. Day 1, Day 7)." },
        "tasksCompleted": { "type": "object", "description": "Map of task IDs to true/false status." },
        "km": { "type": "number", "description": "Total distance logged in kilometers for the day." },
        "kmLogged": { "type": "number", "description": "Total distance logged in kilometers for the day." },
        "steps": { "type": "number", "description": "Total step count logged for the day." },
        "yogaCompleted": { "type": "boolean", "description": "Whether Monday yoga was finished." },
        "notes": { "type": "string", "description": "Client or coach notes for the day." },
        "progressPicture": { "type": "string", "description": "Optional picture upload or note." },
        "completed": { "type": "boolean", "description": "Whether all required tasks for this day are finished." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date"]
    },
    "Workout": {
      "title": "Workout",
      "description": "A user's workout session, including exercises and results.",
      "type": "object",
      "properties": {
        "userEmail": {
          "type": "string",
          "description": "The email of the user who owns this workout."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the workout was created."
        },
        "title": {
          "type": "string",
          "description": "The title of the workout.",
          "minLength": 1,
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "description": "Coach's notes or warmup instructions."
        },
        "cooldown": {
          "type": "string",
          "description": "Cooldown instructions."
        },
        "exercises": {
          "type": "array",
          "description": "List of exercises in the workout.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "name": { "type": "string" },
              "prescription": { "type": "string" }
            },
            "required": ["id", "name"]
          }
        },
        "results": {
          "type": "object",
          "description": "Map of exercise IDs to their results (e.g., weight/reps)."
        }
      },
      "required": ["userEmail", "date", "title", "exercises", "results"]
    },
    "WorkoutTemplate": {
      "title": "WorkoutTemplate",
      "description": "A reusable workout template in the database.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the template.",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the template was saved."
        },
        "notes": {
          "type": "string",
          "description": "Coach's notes for the template."
        },
        "warmup": {
          "type": "string",
          "description": "Warm-up instructions for the template."
        },
        "cooldown": {
          "type": "string",
          "description": "Cooldown instructions for the template."
        },
        "exercises": {
          "type": "array",
          "description": "List of exercises in the template.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "name": { "type": "string" },
              "prescription": { "type": "string" }
            },
            "required": ["id", "name"]
          }
        }
      },
      "required": ["title", "exercises"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Activity alerts for the creator/admin when a client finishes workouts or completes challenge milestones.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of event: workout_completed, challenge_day_completed, challenge_task_completed, or activity_logged."
        },
        "clientEmail": {
          "type": "string",
          "description": "Email of the client who performed the action."
        },
        "clientName": {
          "type": "string",
          "description": "Display name of the client."
        },
        "title": {
          "type": "string",
          "description": "Short title of the event or workout name."
        },
        "message": {
          "type": "string",
          "description": "Human readable notification message."
        },
        "details": {
          "type": "string",
          "description": "Additional context or statistics."
        },
        "workoutId": {
          "type": "string",
          "description": "ID of the completed workout if applicable."
        },
        "date": {
          "type": "string",
          "description": "Date associated with the activity (YYYY-MM-DD)."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the notification was created."
        },
        "read": {
          "type": "boolean",
          "description": "Whether the admin has marked this notification as read."
        }
      },
      "required": ["type", "clientEmail", "message", "timestamp", "read"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Daily movement and activity log for a client.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "loggedKm": {
          "type": "number"
        }
      }
    }
  },
  "firestore": {
    "/users/{emailId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles."
    },
    "/users/{emailId}/workouts/{workoutId}": {
      "schema": {
        "$ref": "#/entities/Workout"
      },
      "description": "Workouts belonging to a specific user."
    },
    "/users/{emailId}/activityLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/ActivityLog"
      },
      "description": "Daily activity logs belonging to a user."
    },
    "/users/{emailId}/challengeLogs/{logDate}": {
      "schema": {
        "$ref": "#/entities/ChallengeDailyLog"
      },
      "description": "Daily challenge logs for a user."
    },
    "/workoutTemplates/{templateId}": {
      "schema": {
        "$ref": "#/entities/WorkoutTemplate"
      },
      "description": "Reusable workout templates."
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Activity notifications for the admin/creator."
    }
  }
}
